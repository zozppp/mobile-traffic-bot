import asyncio
import random
from playwright.async_api import async_playwright

# أسماء الأجهزة الصحيحة والمطابقة لـ Playwright 100%
MOBILE_DEVICES = ["Pixel 5", "iPhone 12", "Galaxy S9+"]


async def send_mobile_visit(visit_num):
    async with async_playwright() as p:
        selected_device = random.choice(MOBILE_DEVICES)
        device_config = p.devices[selected_device]

        browser = await p.chromium.launch(headless=True)

        context = await browser.new_context(
            **device_config,
            locale="en-US",
            timezone_id="America/New_York",
        )

        page = await context.new_page()

        try:
            print(
                f"🚀 [Visit {visit_num}] Connecting as {selected_device}..."
            )
            await page.goto("https://loveoooouuu.blogspot.com/", timeout=60000)
            await page.wait_for_timeout(3000)

            # ضغطة لتفعيل الإعلانات
            await page.tap("body")
            print(f"✅ [Visit {visit_num}] Success!")

        except Exception as e:
            print(f"❌ [Visit {visit_num}] Error: {e}")

        await context.close()
        await browser.close()


async def main():
    # 50 زيارة لكل سيرفر لضمان الاستقرار وسرعة التنفيذ
    for i in range(1, 51):
        await send_mobile_visit(i)
        await asyncio.sleep(random.uniform(1.0, 2.5))


if __name__ == "__main__":
    asyncio.run(main())
